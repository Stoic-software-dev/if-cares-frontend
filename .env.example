# --- Database (Supabase in prod/dev; Docker interim locally) ---
# Supabase: Project Settings -> Database. DATABASE_URL = Transaction pooler (6543),
# DIRECT_URL = direct connection (5432). Local Docker interim: both point to 5433.
DATABASE_URL="postgresql://ifcares:ifcares@localhost:5433/ifcares?schema=public"
DIRECT_URL="postgresql://ifcares:ifcares@localhost:5433/ifcares?schema=public"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""
AUTH_COOKIE_NAME="ifc_session"
SESSION_TTL_HOURS="8"

# --- Program ---
APP_TIMEZONE="America/Chicago"

# Legacy Google Apps Script backend (server-side only: import + reports proxy)
GAS_BASE_URL="https://script.google.com/macros/s/AKfycbwPwKePlcflGz1UcrS3-o7nssAoC0BGSPr8rLuxxjq2nePnWghXlJYI4Bsdvksur3tS/exec"

# School-year prefix that marks sites as active during import
IMPORT_ACTIVE_SY="2025/2026"

# --- Seed admin (dev) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_LASTNAME=""
SEED_ADMIN_PASSWORD=""
