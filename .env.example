# --- Database (Supabase in prod/dev; Docker interim locally) ---
# Supabase: Project Settings -> Database. DATABASE_URL = Transaction pooler (6543),
# DIRECT_URL = direct connection (5432). Local Docker interim: both point to 5433.
DATABASE_URL="postgresql://ifcares:ifcares@localhost:5433/ifcares?schema=public"
DIRECT_URL="postgresql://ifcares:ifcares@localhost:5433/ifcares?schema=public"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""
AUTH_COOKIE_NAME="ifc_session"
SESSION_TTL_HOURS="8"

# --- Program ---
APP_TIMEZONE="America/Chicago"

# Legacy Google Apps Script backend (server-side only: import + reports proxy)
GAS_BASE_URL="https://script.google.com/macros/s/AKfycbwPwKePlcflGz1UcrS3-o7nssAoC0BGSPr8rLuxxjq2nePnWghXlJYI4Bsdvksur3tS/exec"
# Same random string as MIGRATION_EXPORT_KEY in gas-backup/migration-export.gs
GAS_EXPORT_KEY=""

# School-year prefix that marks sites as active during import
IMPORT_ACTIVE_SY="2025/2026"

# --- Seed admin (dev) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_LASTNAME=""
SEED_ADMIN_PASSWORD=""

# Menus live in a Drive folder the office fills by hand. They are read with the
# Drive REST API through a service account: create one in Google Cloud, enable
# the Drive API, download its JSON key, and share the menus folder with the
# service account email (Viewer is enough). While these are empty the app falls
# back to the legacy Apps Script.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_DRIVE_MENUS_FOLDER_ID="1wagBWXeOi_8U5N7zvqUGhdv6AjH1yyki"
# Where the app archives every PDF it generates. Needs Editor for the service
# account. This is the folder the legacy report generator already wrote to.
GOOGLE_DRIVE_REPORTS_FOLDER_ID="1m5PsksV1W_7barLhBuNwTuGNiAgd0mZ_"
