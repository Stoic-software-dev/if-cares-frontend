generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum MealCountSource {
  APP
  GAS_IMPORT
}

model Site {
  id                  String    @id @default(cuid())
  // Full legacy name including the school-year prefix (e.g. "2025/2026 TX COD CHURCHILL REC CENTER").
  // It is the identity the frontend matches against everywhere (dropdowns, assignedSite).
  name                String    @unique
  active              Boolean   @default(true)
  state               String    @default("") // "TX" | "OK" (master Sites col C; drives consolidated reports)
  ceName              String    @default("")
  ceId                String    @default("")
  siteName            String    @default("")
  siteNumber          String    @default("")
  legacySpreadsheetId String?   @unique
  // Reminder window from the master Reminders tab: overdue emails are sent only
  // while today falls inside [reminderStart, reminderEnd].
  reminderStart       DateTime? @db.Date
  reminderEnd         DateTime? @db.Date
  // The cycle the site operates in, and which meals each weekday serves:
  // { "mon": { "brk": false, "lunch": true, "snk": false, "sup": true }, ... }.
  // Together they generate the ServiceDay rows, so a new site is a form instead
  // of two hundred clicks on a calendar.
  programStart        DateTime? @db.Date
  programEnd          DateTime? @db.Date
  weeklyTemplate      Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  students    Student[]
  serviceDays ServiceDay[]
  mealCounts  MealCount[]
  userSites   UserSite[]
  requests    Request[]
  holidays    HolidaySite[]
}

model Student {
  id        String    @id @default(cuid()) // imported rows keep their GAS id verbatim ("AMA_1759327671710")
  number    Int
  name      String
  age       Int?
  birthdate DateTime? @db.Date
  active    Boolean   @default(true)
  siteId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  site    Site             @relation(fields: [siteId], references: [id])
  entries MealCountEntry[]

  // number is positional (GAS reindexes the roster alphabetically on every
  // change) — display data, deliberately NOT unique per site.
  @@unique([siteId, name])
  @@index([siteId, active])
}

model ServiceDay {
  id     String   @id @default(cuid())
  siteId String
  date   DateTime @db.Date
  brk    Boolean  @default(false)
  lunch  Boolean  @default(false)
  snk    Boolean  @default(false)
  sup    Boolean  @default(false)

  site Site @relation(fields: [siteId], references: [id])

  @@unique([siteId, date])
}

model MealCount {
  id               String          @id @default(cuid())
  siteId           String
  date             DateTime        @db.Date
  timeIn           String          @default("") // canonical zero-padded 24h "HH:MM:SS"
  timeOut          String          @default("")
  signature        String          @default("") @db.Text
  source           MealCountSource @default(APP)
  submittedById    String?
  submittedByEmail String          @default("")
  createdAt        DateTime        @default(now())
  // Logical void: a count filed on the wrong day or site. Correcting it cannot
  // fix that, and deleting it would erase the audit trail, so the row stays and
  // every reader filters it out. A voided day is an open service day again.
  voidedAt         DateTime?
  voidedById       String?
  voidedByEmail    String          @default("")
  voidReason       String          @default("")

  site        Site                  @relation(fields: [siteId], references: [id])
  submittedBy User?                 @relation("MealCountSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  voidedBy    User?                 @relation("MealCountVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  entries     MealCountEntry[]
  corrections MealCountCorrection[]

  // Only ONE ACTIVE count per site and date, enforced by a partial unique index
  // created in SQL (`MealCount_siteId_date_active_key ... WHERE voidedAt IS NULL`),
  // which Prisma cannot express. Voided rows stay, so a day can hold the count
  // that was thrown out plus the one that replaced it, and the audit trail keeps
  // both. Read an active count with findFirst({ siteId, date, voidedAt: null }).
  @@index([siteId, date])
  @@index([voidedAt])
}

model MealCountEntry {
  id          String  @id @default(cuid())
  mealCountId String
  studentId   String?
  // Snapshot of the roster row exactly as submitted
  number      Int
  name        String
  age         Int?
  attendance  Boolean @default(false)
  breakfast   Boolean @default(false)
  lunch       Boolean @default(false)
  snack       Boolean @default(false)
  supper      Boolean @default(false)

  mealCount MealCount @relation(fields: [mealCountId], references: [id], onDelete: Cascade)
  student   Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([mealCountId])
  @@index([studentId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique // stored lowercased at the app layer
  name         String
  lastname     String
  passwordHash String? // null = migrated user that must reset before first login
  role         Role     @default(USER)
  allSites     Boolean  @default(false) // legacy assignedSite === 'all'
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sites            UserSite[]
  mealCounts       MealCount[]          @relation("MealCountSubmitter")
  voidedCounts     MealCount[]          @relation("MealCountVoider")
  requests         Request[]            @relation("RequestAuthor")
  answeredRequests Request[]            @relation("RequestResponder")
  auditLogs        AuditLog[]
  resetTokens      PasswordResetToken[]
  corrections      MealCountCorrection[]
  generatedReports GeneratedReport[]
  holidays         Holiday[]
}

model UserSite {
  userId String
  siteId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
}

model Request {
  id               String        @id @default(cuid())
  type             String // one of the 8 UI literals, zod-validated
  amount           Int?
  time             String? // canonical "HH:MM:SS", null when not applicable
  status           RequestStatus @default(NEW)
  siteId           String
  requestedById    String?
  requestedByEmail String        @default("")
  // What the administrator answered. A status change on its own leaves the site
  // watching a label move with no explanation.
  responseComment  String        @default("")
  respondedById    String?
  respondedByEmail String        @default("")
  respondedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  site        Site  @relation(fields: [siteId], references: [id])
  requestedBy User? @relation("RequestAuthor", fields: [requestedById], references: [id], onDelete: SetNull)
  respondedBy User? @relation("RequestResponder", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([siteId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String   @default("")
  action     String // "student.create" | "student.update" | "student.delete" | "mealcount.create" | ...
  entity     String
  entityId   String   @default("")
  payload    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// Small key-value config store (e.g. foundationId.TX / foundationId.OK for the
// consolidated claim reports).
// Crashes in the browser, which until now left no trace anywhere. Reports are
// grouped by fingerprint instead of stored one by one: the same broken screen
// hit by forty sites in a morning is one row with a counter, not forty rows to
// scroll past.
model ClientError {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  message     String
  stack       String    @db.Text
  pathname    String    @default("")
  source      String    @default("") // "boundary" | "window" | "promise"
  userAgent   String    @default("")
  lastEmail   String    @default("") // whoever hit it most recently, when signed in
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([lastSeenAt])
  @@index([resolvedAt])
}

// A named non service period. Holidays are DECLARATIVE: they never delete a
// ServiceDay, they are subtracted when the calendar is read. That is what lets a
// cell say "Thanksgiving" instead of just being blank, and what makes removing a
// holiday put the days straight back.
//
// A day that already carries a count is never affected: the meals were served,
// whatever the calendar says afterwards.
model Holiday {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  // Scope over sites: every site, or the ones listed in HolidaySite.
  allSites    Boolean  @default(true)
  // Scope over meals: the whole day, or only the meals flagged below.
  allMeals    Boolean  @default(true)
  brk         Boolean  @default(false)
  lunch       Boolean  @default(false)
  snk         Boolean  @default(false)
  sup         Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sites     HolidaySite[]

  @@index([startDate, endDate])
}

model HolidaySite {
  holidayId String
  siteId    String

  holiday Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([holidayId, siteId])
  @@index([siteId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256(token); the raw token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Admin edit of a submitted count (STOIC-2201). The CURRENT values live on
// MealCount/MealCountEntry; each correction stores the full prior snapshot,
// so originals are never overwritten. A count with corrections is "corrected".
model MealCountCorrection {
  id               String   @id @default(cuid())
  mealCountId      String
  correctedById    String?
  correctedByEmail String   @default("")
  note             String   @default("")
  // { timeIn, timeOut, entries: [{ number, name, age, attendance, ... }] }
  previous         Json
  createdAt        DateTime @default(now())

  mealCount   MealCount @relation(fields: [mealCountId], references: [id], onDelete: Cascade)
  correctedBy User?     @relation(fields: [correctedById], references: [id], onDelete: SetNull)

  @@index([mealCountId])
}

// Consolidated claim PDFs (STOIC-2204): stored on generation, recoverable
// without regenerating. File bytes live in object storage under storageKey.
model GeneratedReport {
  id             String   @id @default(cuid())
  year           Int
  month          Int // 1-12
  state          String // "TX" | "OK"
  kind           String // e.g. "claim-part1" | "claim-part2"
  fileName       String
  storageKey     String   @default("")
  signedBy       String   @default("")
  signedTitle    String   @default("")
  // The signature itself, as a PNG data URL. Without it the signed claim could
  // only ever be reproduced from the file store, and a claim has to be
  // reproducible from the database alone.
  signature      String   @default("") @db.Text
  signedAt       DateTime?
  // Opaque, single use and expiring: the link is sent to whoever signs, who has
  // no account. Never the id of the document itself.
  signToken      String?  @unique
  signTokenSetAt DateTime?
  createdById    String?
  createdByEmail String   @default("")
  createdAt      DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([year, month, state])
}
